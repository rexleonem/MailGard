generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  PAUSED
  RISK_BLOCKED
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  accounts  Account[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  email        String        @unique
  smtpHost     String
  smtpPort     Int
  password     String        // Encrypted
  domain       String
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  diagnostics  Diagnostic[]
  warmupState  WarmupState?
  emailLogs    EmailLog[]
}

model Diagnostic {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  spf       Boolean
  dkim      Boolean
  dmarc     Boolean
  ipScore   Int
  rawData   Json?
  createdAt DateTime @default(now())
}

model WarmupState {
  id           String    @id @default(cuid())
  accountId    String    @unique
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dayNumber    Int       @default(1)
  currentCount Int       @default(0)
  lastSentAt   DateTime?
  
  // Adaptive Intelligence Fields
  trustLevel   String    @default("NEW") // NEW, LEARNING, STABLE, ELEVATED, DEGRADED
  trustTrend   Float     @default(0.0)   // -1.0 to 1.0
  cooldownUntil DateTime?
  anomalyDetected Boolean @default(false)
  
  updatedAt    DateTime  @updatedAt
}

enum LogStatus {
  QUEUED
  PROCESSING
  SENT
  FAILED
  RETRYING
  BOUNCED
  BLOCKED
}

model EmailLog {
  id           String    @id @default(cuid())
  accountId    String
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recipient    String
  subject      String
  status       LogStatus @default(SENT)
  error        String?
  aiDecision   Json?
  metadata     Json?     
  
  // Execution Data
  workerId     String?
  jobId        String?
  smtpResponse String?
  retryCount   Int       @default(0)
  domain       String?
  
  createdAt    DateTime  @default(now())
}

model SystemEvent {
  id          String    @id @default(cuid())
  type        String    // SMTP, QUEUE, DIAGNOSTICS, AI, ADAPTIVE, SECURITY
  severity    String    // INFO, WARNING, ERROR, CRITICAL
  message     String
  accountId   String?
  userId      String?
  payload     Json?
  createdAt   DateTime  @default(now())
}

model Alert {
  id          String    @id @default(cuid())
  type        String    // BLACKLIST, DNS_FAILURE, SMTP_FAILURES, AI_ESCALATION
  severity    String
  message     String
  accountId   String?
  resolved    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}
