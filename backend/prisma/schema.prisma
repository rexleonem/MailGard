generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  PAUSED
  RISK_BLOCKED
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  name      String?
  accounts  Account[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Account {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  email        String        @unique
  smtpHost     String
  smtpPort     Int
  password     String        // Encrypted
  domain       String
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  diagnostics  Diagnostic[]
  warmupState  WarmupState?
  emailLogs    EmailLog[]
}

model Diagnostic {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  spf       Boolean
  dkim      Boolean
  dmarc     Boolean
  ipScore   Int
  rawData   Json?
  createdAt DateTime @default(now())
}

model WarmupState {
  id           String    @id @default(cuid())
  accountId    String    @unique
  account      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dayNumber    Int       @default(1)
  currentCount Int       @default(0)
  lastSentAt   DateTime?
  
  // Adaptive Intelligence Fields
  trustLevel   String    @default("NEW") // NEW, LEARNING, STABLE, ELEVATED, DEGRADED
  trustTrend   Float     @default(0.0)   // -1.0 to 1.0
  cooldownUntil DateTime?
  anomalyDetected Boolean @default(false)
  
  updatedAt    DateTime  @updatedAt
}

enum LogStatus {
  SENT
  FAILED
  BOUNCED
}

model EmailLog {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recipient   String
  subject     String
  status      LogStatus
  error       String?
  aiDecision  Json?
  createdAt   DateTime  @default(now())
}
